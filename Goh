-- 1. إنشاء جدول البحث الشامل
CREATE VIRTUAL TABLE IF NOT EXISTS products_search USING fts5(
    product_id UNINDEXED,
    title,
    category_path,
    source_keyword
);

-- 2. نسخ البيانات الحالية من جدول المنتجات إلى جدول البحث
INSERT INTO products_search (product_id, title, category_path, source_keyword)
SELECT product_id, title, category_path, source_keyword FROM products;

-- 3. إنشاء مُشغلات (Triggers) لتحديث جدول البحث تلقائياً عند إضافة منتج جديد
CREATE TRIGGER IF NOT EXISTS products_ai AFTER INSERT ON products BEGIN
  INSERT INTO products_search(product_id, title, category_path, source_keyword) 
  VALUES (new.product_id, new.title, new.category_path, new.source_keyword);
END;

CREATE TRIGGER IF NOT EXISTS products_ad AFTER DELETE ON products BEGIN
  DELETE FROM products_search WHERE product_id = old.product_id;
END;

CREATE TRIGGER IF NOT EXISTS products_au AFTER UPDATE ON products BEGIN
  UPDATE products_search 
  SET title = new.title, category_path = new.category_path, source_keyword = new.source_keyword
  WHERE product_id = old.product_id;
END;