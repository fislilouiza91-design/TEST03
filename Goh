        const { html, items, source, kind } = result;

        if (!html && !items) {
          console.log(`      ⛔ p${page}: كل المزودين فشلوا`);
          blocked = true;
          break;
        }

        stats[source] = (stats[source] || 0) + 1;

        // ⭐ معالجة Apify (items) أو HTML
        let products;
        if (kind === 'items') {
          products = items.map(item => ({
            product_id: String(item.productId || ''),
            title: item.title || 'Product',
            price: parseFloat(item.price || 0) || 0,
            original_price: parseFloat(item.originalPrice || 0) || 0,
            discount: '',
            rating: parseFloat(item.rating || 0) || 0,
            orders_count: String(item.soldCount || ''),
            image_url: item.imageUrl || '',
          }));
          console.log(`        📊 Apify items: ${products.length}`);
        } else {
          if (html.length < 5000) {
            console.log(`      ⚠️ p${page}: HTML صغير (${html.length})`);
            continue;
          }
          products = parseItems(html);
        }

        const saved = await saveProductsBatch(products, row.keyword);

        console.log(`      ✅ p${page}: ${products.length} حلّل، ${saved} مخزّن (${source})`);
        keywordSaved += saved;

        if (products.length === 0) {
          console.log(`      ⏹️ لا مزيد من النتائج`);
          break;
        }

        await new Promise(r => setTimeout(r, 2000 + Math.random() * 2000));

      } catch (error) {
        console.log(`      ❌ p${page}: ${error.message.substring(0, 60)}`);
      }
