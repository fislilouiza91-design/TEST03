function buildSearchUrl(keyword, page = 1) {
  return `https://www.aliexpress.com/wholesale?SearchText=${encodeURIComponent(keyword)}&catId=0&page=${page}`;
}

// ═══════════════════════════════════════════
// 12. 🟣 BrightData
// ═══════════════════════════════════════════

async function fetchFromBrightData(keyword, page = 1) {
  const targetUrl = buildSearchUrl(keyword, page);

  const res = await fetch('https://api.brightdata.com/request', {
    method: 'POST',
    headers: {
      'Content-Type': 'application/json',
      'Authorization': `Bearer ${BRIGHTDATA_TOKEN.trim()}`,
    },
    body: JSON.stringify({
      zone: BRIGHTDATA_ZONE.trim(),
      url: targetUrl,
      format: 'raw',
      country: 'us',
    }),
    timeout: 90000,
  });

  if (!res.ok) {
    const errBody = await res.text().catch(() => '');
    const lowerErr = errBody.toLowerCase();

    if (lowerErr.includes('concurrency') || lowerErr.includes('too many')) {
      throw new Error('CONCURRENCY: BrightData');
    }
    if (res.status === 429 || lowerErr.includes('rate limit')) {
      throw new Error('RATE: BrightData');
    }
    if (lowerErr.includes('credits exhausted') || lowerErr.includes('quota') ||
        lowerErr.includes('out of') || res.status === 402) {
      throw new Error('QUOTA: BrightData');
    }
    if (res.status === 401 || res.status === 403) {
      throw new Error('AUTH: BrightData');
    }
    throw new Error(`BrightData ${res.status}`);
  }

  return await res.text();
}

