/* ============================================
   Smart Shopper - Background Service Worker
   (Smart-Turso DB Edition + Auto Translate)
   ============================================ */

const WORKER_URL = 'https://shopper.smailsuit11.workers.dev';

chrome.runtime.onMessage.addListener((msg, sender, sendResponse) => {
  if (!msg) return;

  if (msg.type === 'SMART_SEARCH') {
    // استخراج رقم المنتج (Product ID) من الرابط لضمان دقة البحث
    let pid = '';
    if (sender.tab && sender.tab.url) {
      const match = sender.tab.url.match(/\/item\/(\d+)/) || sender.tab.url.match(/\/i\/(\d+)/);
      if (match) pid = match[1];
    }
    handleSearch(msg, pid, sendResponse);
    return true;
  }

  if (msg.type === 'SMART_LOAD_MORE') {
    let pid = '';
    if (sender.tab && sender.tab.url) {
      const match = sender.tab.url.match(/\/item\/(\d+)/) || sender.tab.url.match(/\/i\/(\d+)/);
      if (match) pid = match[1];
    }
    handleLoadMore(msg, pid, sendResponse);
    return true;
  }

  return true;
});

async function handleSearch(msg, pid, sendResponse) {
  const title = encodeURIComponent(msg.title || '');
  const url = `${WORKER_URL}/search-db?q=${title}&pid=${pid}&page=1`;

  console.log('[Smart Shopper BG] Fetching from DB:', url);

  try {
    const res = await fetch(url);
    if (!res.ok) throw new Error(`HTTP Error: ${res.status}`);
    
    const data = await res.json();
    console.log('[Smart Shopper BG] Received items:', data.items ? data.items.length : 0);
    
    sendResponse({
      ok: true,
      items: data.items || [],
      lastPage: 1,
      hasMore: data.hasMore || false,
      totalItems: data.items ? data.items.length : 0
    });
  } catch (e) {
    console.error('[Smart Shopper BG] Fetch Failed:', e.message);
    sendResponse({ ok: false, error: String(e) });
  }
}

async function handleLoadMore(msg, pid, sendResponse) {
  const title = encodeURIComponent(msg.title || '');
  const nextPage = Math.max(2, parseInt(msg.startPage) || 2);
  const existingIds = (msg.existingIds || []).join(',');
  
  const url = `${WORKER_URL}/search-db?q=${title}&pid=${pid}&page=${nextPage}&existingIds=${existingIds}`;

  try {
    const res = await fetch(url);
    if (!res.ok) throw new Error(`HTTP Error: ${res.status}`);
    
    const data = await res.json();
    
    sendResponse({
      ok: true,
      items: data.items || [],
      lastPage: nextPage,
      hasMore: data.hasMore || false
    });
  } catch (e) {
    console.error('[Smart Shopper BG] Load More Failed:', e.message);
    sendResponse({ ok: false, error: String(e), hasMore: false });
  }
}