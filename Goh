// 16. Parser
// ═══════════════════════════════════════════

function extractText(v) {
  if (v == null) return '';
  if (typeof v === 'string') return v;
  if (typeof v === 'number') return String(v);
  if (typeof v === 'boolean') return v ? 'true' : '';
  if (typeof v === 'object') {
    const keys = ['displayTitle', 'text', 'title', 'value', 'name',
      'formatedActivityPrice', 'formatedPrice', 'minActivityPrice', 'minPrice',
      'price', 'desc', 'label'];
    for (const k of keys) {
      if (v[k] != null && typeof v[k] !== 'object') return String(v[k]);
    }
    for (const k in v) {
      if (typeof v[k] === 'string' && v[k].length > 0) return v[k];
    }
    return '';
  }
  return String(v);
}

function extractJsonArray(html, marker) {
  const i = html.indexOf(marker);
  if (i < 0) return null;
  const j = html.indexOf('[', i);
  if (j < 0) return null;
  let depth = 0, inStr = false, esc = false;
  for (let k = j; k < html.length; k++) {
    const c = html[k];
    if (inStr) {
      if (esc) esc = false;
      else if (c === '\\') esc = true;
      else if (c === '"') inStr = false;
      continue;
    }
    if (c === '"') { inStr = true; continue; }
    if (c === '[') depth++;
    else if (c === ']') { depth--; if (depth === 0) return html.slice(j, k + 1); }
  }
  return null;
}

function clean(s) {
  return String(s).replace(/<[^>]*>/g, ' ').replace(/\s+/g, ' ').trim();
}

function parseItems(html) {
  const arrText = extractJsonArray(html, '"itemList"') || extractJsonArray(html, '"gridItems"');

  if (arrText) {
    let arr;
    try { arr = JSON.parse(arrText); } catch (e) { arr = null; }

    if (Array.isArray(arr) && arr.length > 0) {
      const out = [];
      for (const o of arr) {
        try {
          if (!o || typeof o !== 'object') continue;
          const id = o.productId || o.id || (o.item && o.item.productId);
          if (!id) continue;

          const rawTitle = o.title || (o.item && o.item.title) || o.displayTitle || '';
          const title = clean(extractText(rawTitle));

          let img = '';
          if (o.image) {
            img = typeof o.image === 'string' ? o.image : (o.image.imgUrl || o.image.imageUrl || o.image.url || '');
          }
          if (!img && o.picUrl) {
            img = typeof o.picUrl === 'string' ? o.picUrl : (o.picUrl.imgUrl || o.picUrl.url || '');
          }
          if (img && img.startsWith('//')) img = 'https:' + img;

          const p = o.prices || {};
          const sale = p.salePrice || {};
          const orig = p.originalPrice || {};
          const price = extractText(sale.formatedActivityPrice || sale.formatedPrice ||
                        sale.minActivityPrice || sale.minPrice || p.formatedPrice || p.minPrice || '');
          const oldPrice = extractText(orig.formatedPrice || orig.minPrice || '');
          const discount = extractText(o.discount || sale.discount || '');

          const rating = extractText(
            (o.evaluation && (o.evaluation.starRating || o.evaluation.averageStar)) ||
            o.averageStarRate || o.starRating || ''
          );
          const sold = extractText(o.tradeDesc || o.sold || o.soldCount || '');

          out.push({
            product_id: String(id),
            title: title || 'Product',
            price: parseFloat(String(price).replace(/[^\d.]/g, '')) || 0,
            original_price: parseFloat(String(oldPrice).replace(/[^\d.]/g, '')) || 0,
            discount: discount,
            rating: parseFloat(String(rating).replace(/[^\d.]/g, '')) || 0,
            orders_count: String(sold),
            image_url: img,
          });
        } catch (e) {}
      }

      if (out.length > 0) {
        console.log(`        📊 JSON: ${out.length}`);
        return out;
      }
    }
  }

  const re = /"productId"\s*:\s*"(\d{6,})"/g;
  const seen = new Set();
  const out = [];
  let m;
  while ((m = re.exec(html))) {
    if (seen.has(m[1])) continue;
    seen.add(m[1]);
    out.push({
      product_id: m[1], title: 'Product', price: 0, original_price: 0,
      discount: '', rating: 0, orders_count: '', image_url: '',
    });
  }

  if (out.length > 0) console.log(`        📊 regex: ${out.length}`);
  return out;
}

