-- 1. حذف الجدول القديم
DROP TABLE IF EXISTS products_search;

-- 2. إنشاء فهرس بحث نصي كامل (FTS) على جدول المنتجات الأساسي مباشرة
CREATE INDEX IF NOT EXISTS idx_products_fts ON products USING fts (title, category_path, source_keyword) WITH (weights = 'title=2.0,category_path=1.0,source_keyword=0.5');




