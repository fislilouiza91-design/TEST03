async function runApifyActor(keyword, maxItems = 20) {
  const actorId = 'apt_marble~aliexpress-search-scraper';
  const runUrl = `https://api.apify.com/v2/acts/${actorId}/run-sync-get-dataset-items?token=${APIFY_TOKEN}`;

  const response = await fetch(runUrl, {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ keyword, country: 'us', currency: 'USD', maxItems }),
    timeout: 300000,
  });

  if (!response.ok) {
    if (response.status === 402 || response.status === 429) {
      throw new Error('QUOTA: Apify');
    }
    if (response.status === 401 || response.status === 403) {
      throw new Error('AUTH: Apify');
    }
    throw new Error(`Apify ${response.status}`);
  }
  return await response.json();
}

// ═══════════════════════════════════════════
// 8. دوال مساعدة
// ═══════════════════════════════════════════

function generateImageHash(url) {
  if (!url) return null;
  const m = url.match(/\/([^/]+\.(jpg|jpeg|png|webp))/i);
  if (m) return crypto.createHash('md5').update(m[1]).digest('hex').substring(0, 16);
  return null;
}

function extractTokens(title) {
  if (!title) return '';
  const stop = new Set(['for','the','and','with','from','new','hot','best','free',
    'high','pro','sale','shipping','pcs','piece','set']);
  return title.toLowerCase()
    .replace(/[^\w\s-]/g, ' ')
    .split(/\s+/)
    .filter(w => w.length > 3 && !stop.has(w) && !/^\d+$/.test(w))
    .slice(0, 12)
    .join(' ');
}

// ═══════════════════════════════════════════
// 9. حفظ Apify Products
// ═══════════════════════════════════════════

async function saveApifyProducts(items, seedKeyword, category) {
  const now = Date.now();
  let saved = 0;
  const statements = [];
  const derived = new Map();

  for (const item of items) {
    if (!item.productId || !item.title) continue;
    if (item.title.length < 15) continue;

    const tokens = extractTokens(item.title);
    const words = tokens.split(' ').filter(w => w.length >= 4 && !COMMON_WORDS.has(w));

    statements.push({
      sql: `INSERT OR IGNORE INTO products 
            (product_id, title, title_tokens, category_path,
             current_price_usd, original_price_usd, rating, orders_count,
             image_url, image_hash, source_keyword, source_type,
             first_seen_at, last_updated_at)
            VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, 'apify', ?, ?)`,
      args: [String(item.productId), item.title, tokens,
        (item.categoryPath || []).join(','),
        parseFloat(item.price || 0) || 0,
        parseFloat(item.originalPrice || 0) || 0,
        parseFloat(item.rating || 0) || 0,
        parseInt(item.soldCount || 0) || 0,
        item.imageUrl || '', generateImageHash(item.imageUrl),
        seedKeyword, now, now],
    });

    for (let i = 0; i < words.length - 1; i++) {
      const bigram = `${words[i]} ${words[i + 1]}`;
      if (bigram.length >= 10 && bigram.length <= 35) {
        derived.set(bigram, (derived.get(bigram) || 0) + 1);
      }
    }
  }

  if (statements.length > 0) {
    try {
      const result = await db.batch(statements, 'write');
      for (const r of result) if (toNum(r.rowsAffected) > 0) saved++;
    } catch (e) {}
  }

  const sorted = [...derived.entries()].filter(([_, f]) => f >= 2)
    .sort((a, b) => b[1] - a[1]).slice(0, 10);

  let newKeywords = 0;
  for (const [kw] of sorted) {
    const r = await db.execute({
      sql: `INSERT OR IGNORE INTO keywords_pipeline 
            (keyword, category, source, priority, created_at) 
            VALUES (?, ?, 'apify_derived', 7, ?)`,
      args: [kw, category, now],
    });
    if (toNum(r.rowsAffected) > 0) newKeywords++;
  }

  return { saved, newKeywords };
}

// ═══════════════════════════════════════════
// 10. اختيار Keywords
// ═══════════════════════════════════════════

async function pickKeywordsFromDB(count, category) {
  if (!category) return [];

  const all = await db.execute({
    sql: `SELECT keyword, category FROM keywords_pipeline
          WHERE enabled = 1 
            AND category = ?
            AND (last_run_at = 0 OR last_run_at IS NULL)
          ORDER BY priority ASC, run_count ASC, RANDOM()
          LIMIT ?`,
    args: [category, count],
  });

  return all.rows;
}

async function markProcessed(keyword, success) {
  await db.execute({
    sql: `UPDATE keywords_pipeline
          SET last_run_at = ?, run_count = run_count + 1,
              success_count = success_count + ?, fail_count = fail_count + ?
          WHERE keyword = ?`,
    args: [Date.now(), success ? 1 : 0, success ? 0 : 1, keyword],
  });
}

