// ═══════════════════════════════════════════
// 🔧 Helper: تحويل آمن للأرقام (BigInt من libsql)
// ═══════════════════════════════════════════

function toNum(v) {
  if (v == null) return 0;
  if (typeof v === 'bigint') return Number(v);
  if (typeof v === 'number') return Number.isFinite(v) ? v : 0;
  const n = Number(v);
  return Number.isFinite(n) ? n : 0;
}

