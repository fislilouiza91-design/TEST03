  url.searchParams.set('x-api-key', SCRAPINGANT_KEY);
  url.searchParams.set('url', targetUrl);
  url.searchParams.set('browser', 'false');
  url.searchParams.set('proxy_country', 'US');

  const res = await fetch(url.toString(), { timeout: 60000 });

  if (!res.ok) {
    const errBody = await res.text().catch(() => '');
    const lowerErr = errBody.toLowerCase();

    if (lowerErr.includes('concurrency') || lowerErr.includes('too many')) throw new Error('CONCURRENCY: ScrapingAnt');
    if (res.status === 429 || lowerErr.includes('rate limit')) throw new Error('RATE: ScrapingAnt');
    if (lowerErr.includes('credits exhausted') || lowerErr.includes('quota') ||
        lowerErr.includes('no credits') || res.status === 402) throw new Error('QUOTA: ScrapingAnt');
    if (res.status === 401 || res.status === 403) throw new Error('AUTH: ScrapingAnt');
    throw new Error(`ScrapingAnt ${res.status}`);
  }

  return await res.text();
}

