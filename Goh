// src/smart-pipeline.js - نظام الأولوية الزمنية (ينهي القديم ثم الجديد)
import fetch from 'node-fetch';
import crypto from 'crypto';
import { createClient } from '@libsql/client';

const db = createClient({
  url: process.env.TURSO_URL,
  authToken: process.env.TURSO_TOKEN,
});

const WORKER_URL = 'https://smart-shopper.smailsuit11.workers.dev';

// الإعدادات
const BATCH_SIZE = 30; // عدد الكلمات التي سيتم البحث عنها في كل دورة
const PAGES_PER_KEYWORD = 2; // عدد الصفحات لكل كلمة

// ═══════════════════════════════════════════
// 1. إدارة الفئة النشطة (مع الأولوية الزمنية)
// ═══════════════════════════════════════════
async function getActiveCategory() {
  try {
    // 1. جلب الفئة النشطة حالياً
    const stateRes = await db.execute(`SELECT value FROM system_state WHERE key = 'active_category'`);
    let activeCat = stateRes.rows.length > 0 ? String(stateRes.rows[0].value) : null;

    if (activeCat) {
      // هل لا تزال هناك كلمات غير مبحوث عنها في هذه الفئة؟
      const pending = await db.execute({
        sql: `SELECT 1 FROM keywords_pipeline WHERE category = ? AND last_run_at = 0 AND enabled = 1 LIMIT 1`,
        args: [activeCat]
      });
      
      if (pending.rows.length > 0) {
        console.log(`\n🔄 استكمال العمل على الفئة الحالية: [${activeCat}]`);
        return activeCat; // نكمل مع نفس الفئة
      } else {
        console.log(`\n✅ تم الانتهاء من جميع كلمات الفئة: [${activeCat}]`);
      }
    }

    // 2. اختيار الفئة التالية الأقدم (FIFO) التي لديها كلمات غير مبحوث عنها
    const catsRes = await db.execute(`
      SELECT category, MIN(created_at) as oldest_created
      FROM keywords_pipeline 
      WHERE last_run_at = 0 AND enabled = 1 AND category IS NOT NULL AND category != ''
      GROUP BY category 
      ORDER BY oldest_created ASC
    `);

    if (catsRes.rows.length > 0) {
      // أخذ الفئة الأولى في القائمة (الأقدم)
      activeCat = String(catsRes.rows[0].category);
      console.log(`\n🎲 الانتقال إلى الفئة التالية (الأقدم): [${activeCat}]`);
    } else {
      // 3. اكتملت الدورة! (جميع الكلمات تم البحث عنها)
      console.log(`\n🚨 [تنبيه هام] اكتملت جميع الكلمات في جميع الفئات المخزنة! 🚨`);
      console.log(`⏳ جاري إعادة تصفير الطابور لبدء دورة جديدة...`);
      
      // تصفير الطابور
      await db.execute(`UPDATE keywords_pipeline SET last_run_at = 0 WHERE enabled = 1`);
      
      // جلب الفئة الأقدم للبدء من جديد
      const resetCatsRes = await db.execute(`
        SELECT category, MIN(created_at) as oldest_created
        FROM keywords_pipeline WHERE enabled = 1 AND category IS NOT NULL AND category != ''
        GROUP BY category ORDER BY oldest_created ASC LIMIT 1
      `);
      
      if (resetCatsRes.rows.length === 0) {
        console.log('⚠️ لا توجد كلمات مفتاحية في قاعدة البيانات.');
        return null;
      }
      
      activeCat = String(resetCatsRes.rows[0].category);
      console.log(`🔄 بدء دورة جديدة من الفئة الأولى: [${activeCat}]`);
    }

    // حفظ الفئة الجديدة في قاعدة البيانات
    await db.execute({
      sql: `INSERT OR REPLACE INTO system_state (key, value, updated_at) VALUES ('active_category', ?, ?)`,
      args: [activeCat, Date.now()]
    });

    return activeCat;
  } catch (e) {
    console.error('❌ خطأ في إدارة الفئة:', e.message);
    return null;
  }
}

// ═══════════════════════════════════════════
// 2. جلب الكلمات وتحديثها
// ═══════════════════════════════════════════
async function getKeywordsForCategory(category, limit) {
  const res = await db.execute({
    sql: `SELECT keyword FROM keywords_pipeline 
          WHERE category = ? AND last_run_at = 0 AND enabled = 1 
          ORDER BY RANDOM() LIMIT ?`,
    args: [category, limit]
  });
  return res.rows.map(r => String(r.keyword));
}

async function markKeywordProcessed(keyword) {
  await db.execute({
    sql: `UPDATE keywords_pipeline SET last_run_at = ?, run_count = run_count + 1 WHERE keyword = ?`,
    args: [Date.now(), keyword]
  });
}

// ═══════════════════════════════════════════
// 3. دوال مساعدة
// ═══════════════════════════════════════════
function toNum(v) {
  if (v == null) return 0;
  if (typeof v === 'bigint') return Number(v);
  if (typeof v === 'number') return Number.isFinite(v) ? v : 0;
  const n = Number(v);
  return Number.isFinite(n) ? n : 0;
}

function generateImageHash(url) {
  if (!url) return null;
  const m = url.match(/\/([^/]+\.(jpg|jpeg|png|webp))/i);
  if (m) return crypto.createHash('md5').update(m[1]).digest('hex').substring(0, 16);
  return null;
}

function extractPriceNum(s) {
  const m = String(s || '').replace(/,/g, '').match(/(\d+(?:\.\d+)?)/);
  return m ? parseFloat(m[1]) : 0;
}

// ═══════════════════════════════════════════
// 4. حفظ البيانات
// ═══════════════════════════════════════════
async function saveProductsBatch(products, keyword, category) {
  if (!products || products.length === 0) return 0;
  
  const now = Date.now();
  const productStmts = [];
  const imageStmts = [];
  const priceStmts = [];
  const detailStmts = [];
  const seenIds = new Set();

  for (const p of products) {
    if (!p.id || !p.title || p.title.length < 5) continue;
    if (seenIds.has(p.id)) continue;
    seenIds.add(p.id);

    const priceNum = extractPriceNum(p.price);
    const oldPriceNum = extractPriceNum(p.oldPrice);

    productStmts.push({
      sql: `INSERT INTO products 
            (product_id, title, title_tokens, category_path, current_price_usd, original_price_usd, rating, orders_count, image_url, image_hash, source_keyword, source_type, first_seen_at, last_updated_at)
            VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, 'enrichment', ?, ?)
            ON CONFLICT(product_id) DO UPDATE SET
              current_price_usd = excluded.current_price_usd,
              original_price_usd = excluded.original_price_usd,
              rating = excluded.rating,
              orders_count = excluded.orders_count,
              last_updated_at = excluded.last_updated_at`,
      args: [p.id, p.title, '', category, priceNum, oldPriceNum, parseFloat(p.rating) || 0, p.sold || '', p.img || '', generateImageHash(p.img), keyword, now, now],
    });

    detailStmts.push({
      sql: `INSERT INTO product_details (product_id, currency, in_stock, updated_at) VALUES (?, 'USD', 1, ?) ON CONFLICT(product_id) DO UPDATE SET updated_at = excluded.updated_at`,
      args: [p.id, now]
    });

    if (p.img) {
      imageStmts.push({
        sql: `INSERT OR IGNORE INTO product_images (product_id, image_url, image_hash, position, is_main, created_at) VALUES (?, ?, ?, 0, 1, ?)`,
        args: [p.id, p.img, generateImageHash(p.img), now]
      });
    }

    if (priceNum > 0) {
      priceStmts.push({
        sql: `INSERT OR IGNORE INTO price_history (product_id, price_usd, original_price_usd, recorded_at, source) VALUES (?, ?, ?, ?, 'search_page')`,
        args: [p.id, priceNum, oldPriceNum, now]
      });
    }
  }

  let inserted = 0;
  try {
    if (productStmts.length > 0) {
      const res = await db.batch(productStmts, 'write');
      for (const r of res) if (toNum(r.rowsAffected) > 0) inserted++;
    }
    if (detailStmts.length > 0) await db.batch(detailStmts, 'write');
    if (imageStmts.length > 0) await db.batch(imageStmts, 'write');
    if (priceStmts.length > 0) await db.batch(priceStmts, 'write');
  } catch (e) {
    console.error(`        ❌ DB Error: ${e.message.substring(0, 60)}`);
  }

  return inserted;
}

// ═══════════════════════════════════════════
// 5. لب الإضافة
// ═══════════════════════════════════════════
async function fetchPage(baseUrl, page) {
  try {
    const aliexpressUrl = baseUrl + '&page=' + page;
    const workerEndpoint = `${WORKER_URL}/fetch?url=${encodeURIComponent(aliexpressUrl)}`;
    const res = await fetch(workerEndpoint);
    if (!res.ok) return [];
    const html = await res.text();
    if (html.length < 5000) return [];
    let items = parseItems(html);
    if (!items.length) items = fallbackIds(html);
    return items;
  } catch (e) { return []; }
}

function extractText(v) {
  if (v == null) return '';
  if (typeof v === 'string') return v;
  if (typeof v === 'number') return String(v);
  if (typeof v === 'object') {
    const keys = ['displayTitle', 'text', 'title', 'value', 'name', 'formatedActivityPrice', 'formatedPrice', 'minActivityPrice', 'minPrice', 'price'];
    for (const k of keys) if (v[k] != null && typeof v[k] !== 'object') return String(v[k]);
    for (const k in v) if (typeof v[k] === 'string' && v[k].length > 0) return v[k];
    return '';
  }
  return String(v);
}

function parseItems(html) {
  const arrText = extractJsonArray(html, '"itemList"') || extractJsonArray(html, '"gridItems"');
  if (!arrText) return [];
  let arr;
  try { arr = JSON.parse(arrText); } catch (e) { return []; }
  if (!Array.isArray(arr)) return [];

  const out = [];
  for (const o of arr) {
    try {
      if (!o || typeof o !== 'object') continue;
      const id = o.productId || o.id || (o.item && o.item.productId);
      if (!id) continue;

      const rawTitle = o.title || (o.item && o.item.title) || o.displayTitle || '';
      const title = String(extractText(rawTitle)).replace(/<[^>]*>/g, ' ').replace(/\s+/g, ' ').trim();

      let img = '';
      if (o.image) img = typeof o.image === 'string' ? o.image : (o.image.imgUrl || o.image.imageUrl || o.image.url || '');
      if (!img && o.picUrl) img = typeof o.picUrl === 'string' ? o.picUrl : (o.picUrl.imgUrl || o.picUrl.url || '');
      if (img && img.startsWith('//')) img = 'https:' + img;

      const p = o.prices || {};
      const sale = p.salePrice || {};
      const orig = p.originalPrice || {};
      const price = extractText(sale.formatedActivityPrice || sale.formatedPrice || sale.minActivityPrice || sale.minPrice || p.formatedPrice || p.minPrice || '');
      const oldPrice = extractText(orig.formatedPrice || orig.minPrice || '');
      const rating = extractText((o.evaluation && (o.evaluation.starRating || o.evaluation.averageStar)) || o.averageStarRate || o.starRating || '');
      const sold = extractText(o.tradeDesc || o.sold || o.soldCount || '');

      out.push({ id: String(id), title: title || 'Produit', img, price, oldPrice, rating, sold });
    } catch (e) {}
  }
  return out;
}

function fallbackIds(html) {
  const re = /"productId"\s*:\s*"(\d{6,})"/g;
  const seen = new Set(); const out = [];
  let m;
  while ((m = re.exec(html))) {
    if (seen.has(m[1])) continue;
    seen.add(m[1]);
    out.push({ id: m[1], title: 'Produit', img: '', price: '', oldPrice: '', rating: '', sold: '' });
  }
  return out;
}

function extractJsonArray(html, marker) {
  const i = html.indexOf(marker);
  if (i < 0) return null;
  const j = html.indexOf('[', i);
  if (j < 0) return null;
  let depth = 0, inStr = false, esc = false;
  for (let k = j; k < html.length; k++) {
    const c = html[k];
    if (inStr) {
      if (esc) esc = false;
      else if (c === '\\') esc = true;
      else if (c === '"') inStr = false;
      continue;
    }
    if (c === '"') { inStr = true; continue; }
    if (c === '[') depth++;
    else if (c === ']') { depth--; if (depth === 0) return html.slice(j, k + 1); }
  }
  return null;
}

// ═══════════════════════════════════════════
// 6. المحرك الرئيسي (Main)
// ═══════════════════════════════════════════
async function main() {
  console.log('🧠 Smart Pipeline (FIFO Categories) - بداية جديدة\n');

  const category = await getActiveCategory();
  if (!category) process.exit(1);

  const keywords = await getKeywordsForCategory(category, BATCH_SIZE);
  console.log(`\n📋 تم سحب ${keywords.length} كلمة مفتاحية للبحث في فئة [${category}]\n`);
  
  let totalSaved = 0;

  for (const kw of keywords) {
    console.log(`\n🔍 البحث عن: "${kw}"`);
    let keywordSaved = 0;

    for (let page = 1; page <= PAGES_PER_KEYWORD; page++) {
      try {
        const baseUrl = 'https://www.aliexpress.com/wholesale?SearchText=' + encodeURIComponent(kw.slice(0, 90)) + '&catId=0';
        const products = await fetchPage(baseUrl, page);
        
        if (!products || products.length === 0) break;

        const saved = await saveProductsBatch(products, kw, category);
        console.log(`      ✅ صفحة ${page}: تحليل ${products.length}، جديد ${saved} في DB.`);
        keywordSaved += saved;
        
        await new Promise(r => setTimeout(r, 2000));
      } catch (error) {
        console.error(`      ⚠️ خطأ:`, error.message);
      }
    }
    
    totalSaved += keywordSaved;
    await markKeywordProcessed(kw);
  }

  console.log(`\n📊 النتيجة النهائية لهذه الدورة:`);
  console.log(`  ➕ إجمالي المنتجات الجديدة المضافة: ${totalSaved}`);
  console.log(`  🏁 تم إنهاء ${keywords.length} كلمة في فئة [${category}].`);
}

main().catch(err => {
  console.error('💥 خطأ قاتل:', err);
  process.exit(1);
});
