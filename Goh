// تعديل دالة التحقق من صفحة المنتج لتتجاهل صفحة الحظر
function isProductPage() { 
  // إذا كان الرابط يحتوي على punish أو captcha، فهذا ليس منتجاً
  if (location.href.includes('/punish') || location.href.includes('captcha')) return false;
  return /aliexpress\.(com|us)\/(item|i)\/\d+/i.test(location.href); 
}

// تعديل دالة الفحص (scan) لتتوقف فوراً عند رؤية صفحة الحظر
function scan() {
  if (closed) return;

  // 🛑 إذا كان المستخدم في صفحة الحظر، نخفي الإضافة ونوقف كل شيء
  if (location.href.includes('/punish') || location.href.includes('captcha')) {
    const existing = document.getElementById(PANEL_ID);
    if (existing) existing.remove();
    if (window.SS_Fullscreen && window.SS_Fullscreen.isOpen()) window.SS_Fullscreen.close();
    currentKey = ''; 
    currentProductPrice = 0; 
    searchState.running = false; 
    searchState.complete = false;
    return; // الخروج فوراً دون عمل أي طلبات
  }

  if (!isProductPage()) {
    const existing = document.getElementById(PANEL_ID);
    if (existing) existing.remove();
    if (window.SS_Fullscreen && window.SS_Fullscreen.isOpen()) window.SS_Fullscreen.close();
    currentKey = ''; currentProductPrice = 0; searchState.running = false; searchState.complete = false;
    return;
