/* ============================================
   Smart Shopper - Background Service Worker
   Bulk Fetching (5 Pages) + Smart Geo-Routing
   ============================================ */

const WORKER_URL = 'https://competitors-api.smailsuit11.workers.dev';
const STOP_WORDS = new Set(['free', 'shipping', 'hot', 'sale', 'new', 'original', 'quality', 'wholesale', 'dropshipping', 'fast', 'delivery', 'cheap', 'for', 'and', 'with', 'the', 'a', 'of', 'to', 'in', 'on', 'is', 'by', 'at', 'from', 'or', 'an', 'as', 'be', 'this', 'that', 'it', 'not', 'are', 'was', 'if', 'but', 'high', 'good']);

chrome.runtime.onMessage.addListener((msg, sender, sendResponse) => {
  if (!msg) return;

  if (msg.type === 'CHECK_CACHE') {
    fetch(`${WORKER_URL}/api/competitors?productId=${msg.productId}`)
      .then(res => { if(res.ok) return res.json(); throw new Error('Not found'); })
      .then(data => sendResponse({ ok: true, data: data.data }))
      .catch(() => sendResponse({ ok: false }));
    return true;
  }

  if (msg.type === 'SMART_SEARCH') {
    handleSearch(msg, sender, sendResponse);
    return true;
  }
  return true;
});

/* ============================================
   البحث الأولي - صفحة 1 + جلب 5 صفحات في الخلفية
   ============================================ */
async function handleSearch(msg, sender, sendResponse) {
  const tabId = sender.tab.id;
  const originalTitle = msg.title;
  const country = msg.country || 'US';
  const productId = msg.productId;
  const q = encodeURIComponent(originalTitle.slice(0, 90));
  const baseUrl = 'https://www.aliexpress.com/wholesale?SearchText=' + q + '&catId=0';

  try {
    // 1. جلب الصفحة الأولى وعرضها فوراً
    let allItemsRaw = await fetchPage(baseUrl, 1, country);
    let seenIds = new Set(allItemsRaw.map(i => i.id));
    let relevantPage1 = filterByRelevance(originalTitle, allItemsRaw);

    sendResponse({
      ok: true, items: relevantPage1, lastPage: 1, hasMore: true,
      totalItems: relevantPage1.length, searchUrl: baseUrl
    });

    // 2. بدء الجلب الخفي للصفحات من 2 إلى 5
    if (tabId) {
      chrome.tabs.sendMessage(tabId, { type: 'SMART_FETCH_START' }).catch(()=>{});
    }

    for (let page = 2; page <= 5; page++) {
      let pageRaw = await fetchPage(baseUrl, page, country);
      if (!pageRaw || pageRaw.length === 0) break; // نفدت المنتجات

      let uniqueRaw = pageRaw.filter(it => !seenIds.has(it.id));
      if (uniqueRaw.length === 0 && pageRaw.length < 5) break; // وصلنا للنهاية

      uniqueRaw.forEach(it => seenIds.add(it.id));
      allItemsRaw = allItemsRaw.concat(uniqueRaw);

      // فلترة الصفحة الجديدة وإرسالها لواجهة المستخدم
      let relevantNew = filterByRelevance(originalTitle, uniqueRaw);
      if (relevantNew.length > 0 && tabId) {
        chrome.tabs.sendMessage(tabId, { type: 'SMART_BACKGROUND_UPDATE', items: relevantNew }).catch(()=>{});
      }
    }

    if (tabId) {
      chrome.tabs.sendMessage(tabId, { type: 'SMART_FETCH_DONE' }).catch(()=>{});
    }

    // 3. حفظ كل شيء في D1، والمتشابه فقط في KV
    let allRelevant = filterByRelevance(originalTitle, allItemsRaw);
    if (productId && allItemsRaw.length > 0) {
      saveToCloudflare(productId, allItemsRaw, allRelevant);
    }

  } catch (e) {
    sendResponse({ ok: false, error: String(e) });
  }
}

function saveToCloudflare(productId, allRawItems, allRelevantItems) {
  const payload = {
    base_product_id: productId,
    all_items: allRawItems.map(c => ({
      competitor_id: c.id, title: c.title, price: c.price, currency: 'USD',
      seller_rating: c.rating, product_url: c.link
    })),
    relevant_items: allRelevantItems.map(c => ({
      competitor_id: c.id, title: c.title, price: c.price, currency: 'USD',
      seller_rating: c.rating, product_url: c.link
    }))
  };

  fetch(`${WORKER_URL}/api/competitors`, {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify(payload)
  }).then(res => res.json()).then(data => console.log('💾 Saved to Cloudflare:', data)).catch(console.error);
}

/* ============================================
   Fetch & Filter Utilities
   ============================================ */
async function fetchPage(baseUrl, page, country) {
  try {
    const aliexpressUrl = baseUrl + '&page=' + page;
    const workerEndpoint = `${WORKER_URL}/api/fallback-scrape?url=${encodeURIComponent(aliexpressUrl)}&country=${country}`;
    const res = await fetch(workerEndpoint);
    if (!res.ok) return [];
    const data = await res.json();
    if (!data.html || data.html.length < 5000) return [];

    let items = parseItems(data.html);
    if (!items.length) items = fallbackIds(data.html);
    return items;
  } catch (e) { return []; }
}

function filterByRelevance(originalTitle, items) {
  if (!originalTitle || !items.length) return items;
  const cleanTitle = originalTitle.toLowerCase().replace(/[^a-z0-9\s]/g, ' ');
  const baseWords = cleanTitle.split(/\s+/).filter(w => w.length > 1 && !STOP_WORDS.has(w) && !/^\d{4}$/.test(w));
  if (baseWords.length === 0) return items; 

  const scoredItems = items.map(it => {
    const itemTitle = (it.title || '').toLowerCase().replace(/[^a-z0-9\s]/g, ' ');
    let matchCount = 0;
    for (const word of baseWords) { if (itemTitle.includes(word)) matchCount++; }
    return { ...it, matchScore: matchCount / baseWords.length };
  });

  const filtered = scoredItems.filter(it => it.matchScore >= 0.2);
  filtered.sort((a, b) => b.matchScore - a.matchScore);
  return filtered;
}

/* ============================================
   Parse items from HTML
   ============================================ */
function extractText(v) {
  if (v == null) return '';
  if (typeof v === 'string') return v;
  if (typeof v === 'number') return String(v);
  if (typeof v === 'boolean') return v ? 'true' : '';
  if (typeof v === 'object') {
    const keys = ['displayTitle', 'text', 'title', 'value', 'name', 'formatedActivityPrice', 'formatedPrice', 'minActivityPrice', 'minPrice', 'price', 'desc', 'label'];
    for (const k of keys) { if (v[k] != null && typeof v[k] !== 'object') return String(v[k]); }
    for (const k in v) { if (typeof v[k] === 'string' && v[k].length > 0) return v[k]; }
    return '';
  }
  return String(v);
}

function parseItems(html) {
  const arrText = extractJsonArray(html, '"itemList"') || extractJsonArray(html, '"gridItems"');
  if (!arrText) return [];
  let arr;
  try { arr = JSON.parse(arrText); } catch (e) { return []; }
  if (!Array.isArray(arr)) return [];

  const out = [];
  for (const o of arr) {
    try {
      if (!o || typeof o !== 'object') continue;
      const id = o.productId || o.id || (o.item && o.item.productId);
      if (!id) continue;
      const rawTitle = o.title || (o.item && o.item.title) || o.displayTitle || '';
      const title = clean(extractText(rawTitle));
      let img = '';
      if (o.image) { if (typeof o.image === 'string') img = o.image; else img = o.image.imgUrl || o.image.imageUrl || o.image.url || ''; }
      if (!img && o.picUrl) { if (typeof o.picUrl === 'string') img = o.picUrl; else img = o.picUrl.imgUrl || o.picUrl.url || ''; }
      if (img && img.startsWith('//')) img = 'https:' + img;

      const p = o.prices || {};
      const sale = p.salePrice || {};
      const price = extractText(sale.formatedActivityPrice || sale.formatedPrice || sale.minActivityPrice || sale.minPrice || p.formatedPrice || p.minPrice || '');
      const rating = extractText((o.evaluation && (o.evaluation.starRating || o.evaluation.averageStar)) || o.averageStarRate || o.starRating || '');
      const sold = extractText(o.tradeDesc || o.sold || o.soldCount || '');

      out.push({ id: String(id), title: title || 'Produit similaire', img, price, rating, sold, link: 'https://www.aliexpress.com/item/' + id + '.html' });
    } catch (e) {}
  }
  return out;
}

function fallbackIds(html) {
  const re = /"productId"\s*:\s*"(\d{6,})"/g;
  const seen = new Set(); const out = [];
  let m;
  while ((m = re.exec(html))) {
    if (seen.has(m[1])) continue;
    seen.add(m[1]);
    out.push({ id: m[1], title: 'Produit similaire', img: '', price: '', rating: '', sold: '', link: 'https://www.aliexpress.com/item/' + m[1] + '.html' });
  }
  return out;
}

function extractJsonArray(html, marker) {
  const i = html.indexOf(marker);
  if (i < 0) return null;
  const j = html.indexOf('[', i);
  if (j < 0) return null;
  let depth = 0, inStr = false, esc = false;
  for (let k = j; k < html.length; k++) {
    const c = html[k];
    if (inStr) { if (esc) esc = false; else if (c === '\\') esc = true; else if (c === '"') inStr = false; continue; }
    if (c === '"') { inStr = true; continue; }
    if (c === '[') depth++;
    else if (c === ']') { depth--; if (depth === 0) return html.slice(j, k + 1); }
  }
  return null;
}

function clean(s) { return String(s).replace(/<[^>]*>/g, ' ').replace(/\s+/g, ' ').trim(); }