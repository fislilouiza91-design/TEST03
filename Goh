/* ============================================
   Smart Shopper - Background Service Worker
   Smart Grid Logic (Exact Matches first -> Fill with Similar)
   ============================================ */

const WORKER_URL = 'https://competitors-api.smailsuit11.workers.dev';
const MAX_PAGES_TO_FETCH = 2; 

const STOP_WORDS = new Set([
  'free', 'shipping', 'hot', 'sale', 'new', 'original', 'quality', 'wholesale', 
  'dropshipping', 'fast', 'delivery', 'cheap', 'for', 'and', 'with', 'the', 
  'a', 'of', 'to', 'in', 'on', 'is', 'by', 'at', 'from', 'or', 'an', 'as', 
  'be', 'this', 'that', 'it', 'not', 'are', 'was', 'if', 'but', 'high', 'good',
  '2023', '2024', '2025', '2026', 'best', 'top', 'pcs', 'set', 'pack'
]);

chrome.runtime.onMessage.addListener((msg, sender, sendResponse) => {
  if (!msg) return;

  if (msg.type === 'CHECK_CACHE') {
    fetch(`${WORKER_URL}/api/competitors?productId=${msg.productId}`)
      .then(res => { if(res.ok) return res.json(); throw new Error('Not found'); })
      .then(data => sendResponse({ ok: true, data: data.data }))
      .catch(() => sendResponse({ ok: false }));
    return true;
  }

  if (msg.type === 'SMART_SEARCH') {
    const searchQuery = buildSearchQuery(msg.title);
    const q = encodeURIComponent(searchQuery);
    
    fetch(`${WORKER_URL}/api/fetch-page?q=${q}&page=1&country=${msg.country}`)
      .then(res => res.json())
      .then(data => {
         if (data.ok) {
            // 🔥 تطبيق منطق الشبكة الذكية
            let processedItems = processSmartGrid(msg.title, data.items);
            sendResponse({ ok: true, items: processedItems, hasMore: data.items.length > 0 });
            
            // حفظ المنتجات الدقيقة فقط في قاعدة البيانات لتوفير المساحة
            let exactMatches = processedItems.filter(i => i.isExactMatch);
            if (msg.productId && exactMatches.length > 0) {
                saveToCloudflare(msg.productId, exactMatches, exactMatches);
            }
         } else {
            sendResponse({ ok: false, error: data.error });
         }
      }).catch(err => sendResponse({ ok: false, error: err.message }));
    return true;
  }

  if (msg.type === 'SMART_LOAD_MORE') {
    const nextPage = Math.max(2, parseInt(msg.startPage) || 2);
    if (nextPage > MAX_PAGES_TO_FETCH) return sendResponse({ ok: true, items: [], hasMore: false }); 

    const searchQuery = buildSearchQuery(msg.title);
    const q = encodeURIComponent(searchQuery);

    fetch(`${WORKER_URL}/api/fetch-page?q=${q}&page=${nextPage}&country=${msg.country}`)
      .then(res => res.json())
      .then(data => {
         if (data.ok) {
            let existingIds = new Set(msg.existingIds);
            let unique = data.items.filter(i => !existingIds.has(i.id));
            
            let processedItems = processSmartGrid(msg.title, unique);
            const hasMore = processedItems.length > 0 && nextPage < MAX_PAGES_TO_FETCH;
            
            sendResponse({ ok: true, items: processedItems, hasMore: hasMore });
            
            let exactMatches = processedItems.filter(i => i.isExactMatch);
            if (msg.productId && exactMatches.length > 0) {
                saveToCloudflare(msg.productId, exactMatches, exactMatches);
            }
         } else {
            sendResponse({ ok: false, error: data.error, hasMore: false });
         }
      }).catch(err => sendResponse({ ok: false, error: err.message, hasMore: false }));
    return true;
  }
});

/* ============================================
   دوال الشبكة الذكية (Smart Grid)
   ============================================ */

// 1. بناء استعلام بحث يعتمد على الماركة والموديل
function buildSearchQuery(title) {
  if (!title) return '';
  const cleanTitle = title.toLowerCase().replace(/[^a-z0-9\s]/g, ' ');
  const words = cleanTitle.split(/\s+/).filter(w => w.length > 1 && !STOP_WORDS.has(w));

  const models = words.filter(w => /[a-z]/.test(w) && /[0-9]/.test(w));
  const brand = words.length > 0 ? words[0] : '';
  
  if (models.length > 0 && brand) return `${brand} ${models[0]}`;
  return words.slice(0, 3).join(' ');
}

// 2. معالجة المنتجات وترتيبها (دقيق أولاً، ثم مشابه)
function processSmartGrid(originalTitle, items) {
  if (!originalTitle || !items.length) return [];
  
  const cleanOriginal = originalTitle.toLowerCase().replace(/[^a-z0-9\s]/g, ' ');
  const baseWords = [...new Set(cleanOriginal.split(/\s+/).filter(w => w.length > 1 && !STOP_WORDS.has(w)))];
  if (baseWords.length === 0) return items; 

  const modelTokens = baseWords.filter(w => /[a-z]/.test(w) && /[0-9]/.test(w));
  const brandToken = baseWords[0];

  const scoredItems = items.map(it => {
    const itemTitle = (it.title || '').toLowerCase().replace(/[^a-z0-9\s]/g, ' ');
    
    // حساب عدد الكلمات المتطابقة
    let matchCount = 0;
    for (const word of baseWords) { if (itemTitle.includes(word)) matchCount++; }
    const ratio = matchCount / baseWords.length;

    // هل يحتوي على الموديل والماركة؟
    const hasModel = modelTokens.length > 0 ? modelTokens.some(m => itemTitle.includes(m)) : true;
    const hasBrand = itemTitle.includes(brandToken);

    // تقييم المنتج
    let score = ratio * 100;
    if (hasModel) score += 50;
    if (hasBrand) score += 30;

    // تحديد ما إذا كان المنتج "دقيقاً" أم "مشابهاً"
    const isExactMatch = hasModel && ratio >= 0.4; 
    
    return { ...it, matchScore: score, isExactMatch };
  });

  // فصل المنتجات الدقيقة عن المشابهة
  const exactMatches = scoredItems.filter(i => i.isExactMatch);
  const similarMatches = scoredItems.filter(i => !i.isExactMatch && i.matchScore > 10); // مشابه بدرجة معقولة

  // ترتيب كل مجموعة حسب التقييم
  exactMatches.sort((a, b) => b.matchScore - a.matchScore);
  similarMatches.sort((a, b) => b.matchScore - a.matchScore);

  // إذا كان لدينا ما يكفي من المنتجات الدقيقة (10 أو أكثر)، نعرضها فقط
  // وإلا، نعرض الدقيقة أولاً ثم نكمل بالمنتجات المشابهة
  if (exactMatches.length >= 10) {
      return exactMatches;
  } else {
      return [...exactMatches, ...similarMatches];
  }
}

function saveToCloudflare(productId, allRawItems, relevantNewItems) {
  const payload = {
    base_product_id: productId,
    all_items: allRawItems.map(c => ({
      competitor_id: c.id, title: c.title, price: c.price, currency: 'USD',
      seller_rating: c.rating, product_url: c.link
    })),
    relevant_items: relevantNewItems.map(c => ({
      competitor_id: c.id, title: c.title, price: c.price, currency: 'USD',
      seller_rating: c.rating, product_url: c.link
    }))
  };
  fetch(`${WORKER_URL}/api/competitors`, {
    method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(payload)
  }).then(res => res.json()).then(data => console.log('💾 Saved:', data)).catch(console.error);
}