export default {
  async fetch(request, env, ctx) {
    const corsHeaders = {
      "Access-Control-Allow-Origin": "*",
      "Access-Control-Allow-Methods": "GET, HEAD, POST, OPTIONS",
      "Access-Control-Allow-Headers": "Content-Type",
    };

    if (request.method === "OPTIONS") {
      return new Response(null, { headers: corsHeaders });
    }

    const url = new URL(request.url);

    if (url.pathname === '/search-db') {
      let originalTitle = url.searchParams.get('q') || '';
      let title = originalTitle;
      const pid = url.searchParams.get('pid') || '';
      const page = parseInt(url.searchParams.get('page')) || 1;
      const existingIds = url.searchParams.get('existingIds') || '';
      
      try {
        if (!env.TURSO_URL || !env.TURSO_TOKEN) {
          throw new Error("Missing Turso configuration");
        }

        // 1. جلب العنوان الإنجليزي الأصلي
        if (pid) {
          try {
            const scraperUrl = `https://smart-shopper.smailsuit11.workers.dev/fetch?url=https://www.aliexpress.com/item/${pid}.html`;
            const scrapeRes = await fetch(scraperUrl);
            if (scrapeRes.ok) {
              const html = await scrapeRes.text();
              const ogTitleMatch = html.match(/<meta property="og:title" content="([^"]+)"/i);
              if (ogTitleMatch && ogTitleMatch[1]) {
                title = ogTitleMatch[1];
              }
            }
          } catch (e) {}
        }

        // 2. الترجمة (كخطة بديلة)
        if (title === originalTitle && title.length > 0) {
          title = await translateToEnglish(title);
        }

        // 3. البحث في قاعدة البيانات
        const result = await searchTursoDB(title, page, existingIds, env);
        
        return new Response(JSON.stringify(result), {
          headers: { ...corsHeaders, 'Content-Type': 'application/json' }
        });
      } catch (e) {
        return new Response(JSON.stringify({ ok: false, error: e.message }), {
          status: 500, headers: { ...corsHeaders, 'Content-Type': 'application/json' }
        });
      }
    }

    return new Response('Smart-Turso API is running.', { status: 200, headers: corsHeaders });
  }
}

async function translateToEnglish(text) {
  try {
    const url = `https://translate.googleapis.com/translate_a/single?client=gtx&sl=auto&tl=en&dt=t&q=${encodeURIComponent(text)}`;
    const res = await fetch(url);
    if (!res.ok) return text;
    const data = await res.json();
    if (data && data[0] && data[0][0] && data[0][0][0]) {
      return data[0].map(item => item[0]).join('');
    }
  } catch (e) {}
  return text;
}

async function searchTursoDB(title, page, existingIds, env) {
  const stopWords = new Set([
    'for', 'the', 'and', 'with', 'from', 'new', 'hot', 'best', 'free', 'high', 'pro',
    'sale', 'sales', 'shipping', 'pcs', 'piece', 'set', 'plus', 'original', 'official', 
    'good', 'quality', 'smart', 'portable', 'wireless', 'digital', 'type', 'model', 
    'color', 'size', 'men', 'women', 'kids', 'baby', 'home', 'car', 'phone', 'case', 
    'made', 'material', 'style', 'fashion', 'design', 'item', 'top', 'super', 'ultra', 
    'mini', 'max', 'premium', 'fast', 'pack', 'box', 'quick', 'release', 'replacement', 
    'gift', 'drop', 'ship', 'factory', 'direct', 'wholesale', 'dropshipping', 
    'performance', 'sports', 'racing', 'gas', 'cc', '4x', '10x', '100', 'mah',
    'large', 'capacity', 'charging', 'charger', 'external', 'device', 'storage', 'capsule',
    'cable', 'adapter', 'cover', 'protector', 'glass', 'iphone', 
    'samsung', 'xiaomi', 'huawei', 'redmi', 'poco', 'oppo', 'vivo', 'realme'
  ]);
  
  const allWords = title.toLowerCase().replace(/[^\w\s]/g, ' ').split(/\s+/);
  let meaningfulWords = allWords.filter(w => w.length > 2 && !stopWords.has(w) && !/^\d+$/.test(w));

  if (meaningfulWords.length === 0) return { ok: true, items: [], hasMore: false };

  let keywords = meaningfulWords.slice(0, 4);
  keywords = keywords.map(k => k.endsWith('s') && k.length > 4 ? k.slice(0, -1) : k);
  keywords = [...new Set(keywords)];

  const conditions = keywords.map(() => `p.title LIKE ?`).join(' OR ');
  let scoreSql = keywords.map(() => `(CASE WHEN p.title LIKE ? THEN 10 ELSE 0 END)`).join(' + ');

  const queryArgs = [];
  keywords.forEach(k => queryArgs.push({ type: 'text', value: `%${k}%` }));
  keywords.forEach(k => queryArgs.push({ type: 'text', value: `%${k}%` }));

  let excludeCondition = '';
  if (existingIds) {
    const ids = existingIds.split(',');
    excludeCondition = `AND p.product_id NOT IN (${ids.map(() => '?').join(',')})`;
    ids.forEach(id => queryArgs.push({ type: 'text', value: id }));
  }

  const LIMIT = 60;
  const OFFSET = (page - 1) * LIMIT;
  
  // نمرر المتغيرات لاستعلام الدقة العالية
  queryArgs.push({ type: 'float', value: LIMIT });
  queryArgs.push({ type: 'float', value: OFFSET });

  // 🔥 تم إصلاح الاستعلام: إضافة last_updated_at داخل الاستعلام الفرعي
  const sql = `
    SELECT * FROM (
      SELECT p.product_id as id, p.title, p.last_updated_at,
             COALESCE(NULLIF(p.image_url, ''), pi.image_url) as img,
             p.current_price_usd as price, p.original_price_usd as oldPrice, 
             p.rating, p.orders_count as sold,
             (${scoreSql}) AS score
      FROM products p
      LEFT JOIN product_images pi ON p.product_id = pi.product_id AND pi.is_main = 1
      WHERE (${conditions})
        ${excludeCondition}
    ) AS sub
    WHERE score >= 20
    ORDER BY score DESC, last_updated_at DESC
    LIMIT ? OFFSET ?
  `;

  const httpUrl = env.TURSO_URL.replace(/^libsql:\/\//, 'https://');
  
  // دالة داخلية لتنفيذ الاستعلام
  const executeQuery = async (querySql, args) => {
    const tursoRes = await fetch(`${httpUrl}/v2/pipeline`, {
      method: 'POST',
      headers: {
        'Authorization': `Bearer ${env.TURSO_TOKEN}`,
        'Content-Type': 'application/json'
      },
      body: JSON.stringify({
        requests: [
          { type: 'execute', stmt: { sql: querySql, args: args } },
          { type: 'close' }
        ]
      })
    });
    if (!tursoRes.ok) throw new Error(`Turso HTTP Error: ${tursoRes.status}`);
    const data = await tursoRes.json();
    return data.results[0];
  };

  // المحاولة الأولى: بحث دقيق (كلمتين على الأقل)
  let result = await executeQuery(sql, queryArgs);

  // إذا كانت الصفحة الأولى، ولم نجد أي نتائج بالبحث الدقيق، نتراجع للبحث المرن
  if (result.response.result.rows.length === 0 && page === 1) {
    console.log("⚠️ No strict results, falling back to loose search...");
    
    // نغير شرط النقاط إلى 10 (كلمة واحدة)
    const fallbackSql = sql.replace('WHERE score >= 20', 'WHERE score >= 10');
    result = await executeQuery(fallbackSql, queryArgs);
  }

  if (result.type === 'error') throw new Error(result.error.message);
  
  const cols = result.response.result.cols.map(c => c.name);
  const rows = result.response.result.rows;
  
  const items = rows.map(row => {
    const obj = {};
    cols.forEach((col, i) => { obj[col] = row[i].value; });
    
    const discount = obj.oldPrice && obj.price ? Math.round(((obj.oldPrice - obj.price) / obj.oldPrice) * 100) : 0;
    
    return {
      id: obj.id,
      title: obj.title,
      img: obj.img || '',
      price: obj.price ? String(obj.price) : '',
      oldPrice: obj.oldPrice ? String(obj.oldPrice) : '',
      discount: discount > 0 ? String(discount) : '',
      rating: obj.rating ? String(obj.rating) : '',
      sold: obj.sold ? String(obj.sold) : '',
      link: `https://www.aliexpress.com/item/${obj.id}.html`
    };
  });

  return {
    ok: true,
    items: items,
    hasMore: items.length === LIMIT
  };
}