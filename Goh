async function fetchWithFallback(keyword, page = 1) {
  const providers = [
    { name: 'apify',       fn: runApifyActor,         state: providerState.apify,       icon: '🅰️', kind: 'items', onlyPage1: true },
    { name: 'brightdata',  fn: fetchFromBrightData,   state: providerState.brightdata,  icon: '🟣', kind: 'html',  onlyPage1: false },
    { name: 'scrapingant', fn: fetchFromScrapingAnt,  state: providerState.scrapingant, icon: '🔵', kind: 'html',  onlyPage1: false },
    { name: 'scraperapi',  fn: fetchFromScraperAPI,   state: providerState.scraperapi,  icon: '🟠', kind: 'html',  onlyPage1: false },
  ];

  for (const p of providers) {
    if (p.state.status === 'disabled') {
      console.log(`      ⏭️ ${p.name}: معطل`);
      continue;
    }

    // Apify لا يدعم الصفحات المتعددة
    if (p.onlyPage1 && page > 1) {
      console.log(`      ⏭️ ${p.name}: لا يدعم p${page}`);
      continue;
    }

    for (let attempt = 1; attempt <= 3; attempt++) {
      try {
        console.log(`      ${p.icon} ${p.name} p${page} (${attempt}/3)...`);

        const result = p.kind === 'items'
          ? await p.fn(keyword, APIFY_MAX_ITEMS)
          : await p.fn(keyword, page);

        p.state.consecutiveFailures = 0;

        return {
          html: p.kind === 'html' ? result : null,
          items: p.kind === 'items' ? result : null,
          source: p.name,
          kind: p.kind,
        };

      } catch (e) {
        const msg = e.message;
        console.log(`      ⚠️ ${msg.substring(0, 80)}`);

        if (msg.includes('QUOTA')) {
          console.log(`      🔴 ${p.name}: نفد الرصيد → تعطيل`);
          p.state.status = 'disabled';
          p.state.reason = 'quota_exhausted';
          break;
        }
        if (msg.includes('AUTH')) {
          console.log(`      🔴 ${p.name}: مفتاح خاطئ → تعطيل`);
          p.state.status = 'disabled';
          p.state.reason = 'auth_failed';
          break;
        }
        if (msg.includes('CONCURRENCY') || msg.includes('RATE')) {
          if (attempt < 3) {
            await new Promise(r => setTimeout(r, 2000 * attempt));
            continue;
          } else {
            p.state.consecutiveFailures++;
            if (p.state.consecutiveFailures >= MAX_CONSECUTIVE_FAILURES) {
              p.state.status = 'disabled';
              p.state.reason = 'too_many_failures';
            }
            break;
          }
        }
        p.state.consecutiveFailures++;
        break;
      }
    }
  }

  return { html: null, items: null, source: null, kind: null };
}

