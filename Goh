async function pickRandomCategory() {
  try {
    const res = await db.execute(`
      SELECT DISTINCT category FROM keywords_pipeline
      WHERE enabled = 1 AND category IS NOT NULL AND category != ''
    `);

    if (res.rows.length === 0) {
      console.log('⚠️ لا توجد فئات في keywords_pipeline');
      return null;
    }

    const cats = res.rows.map(r => String(r.category));

    const saved = await db.execute(
      `SELECT value FROM system_state WHERE key = 'category_cycle'`
    );

    let used = [];

    if (saved.rows.length > 0) {
      try {
        const state = JSON.parse(saved.rows[0].value);
        const ageDays = (Date.now() - (state.savedAt || 0)) / (1000 * 60 * 60 * 24);
        if (ageDays < 7) {
          used = Array.isArray(state.used) ? state.used : [];
        }
      } catch (e) {}
    }

    let remaining = cats.filter(c => !used.includes(c));
    let cycleReset = false;

    if (remaining.length === 0) {
      console.log('  🔄 اكتملت كل الفئات — بدء دورة جديدة');
      used = [];
      remaining = cats;
      cycleReset = true;
    }

    const picked = remaining[Math.floor(Math.random() * remaining.length)];
    used.push(picked);

    await db.execute({
      sql: `INSERT OR REPLACE INTO system_state (key, value, updated_at) 
            VALUES ('category_cycle', ?, ?)`,
      args: [JSON.stringify({
        used,
        lastPicked: picked,
        totalCats: cats.length,
        savedAt: Date.now(),
      }), Date.now()],
    });

    console.log(`\n🎲 الفئة المختارة: [${picked}]`);
    console.log(`   📚 إجمالي الفئات: ${cats.length}`);
    console.log(`   ⏳ متبقٍ في الدورة: ${remaining.length - 1}`);
    console.log(`   📋 مستخدمة حتى الآن: ${used.length}`);

    const stRes = await db.execute({
      sql: `SELECT 
              COUNT(*) as total,
              SUM(CASE WHEN last_run_at = 0 OR last_run_at IS NULL THEN 1 ELSE 0 END) as pending
            FROM keywords_pipeline
            WHERE enabled = 1 AND category = ?`,
      args: [picked],
    });
    const total = toNum(stRes.rows[0]?.total);
    const pending = toNum(stRes.rows[0]?.pending);
    console.log(`   📊 كلمات الفئة: ${total} (جديدة: ${pending})\n`);

    return picked;
  } catch (e) {
    console.error(`❌ فشل اختيار الفئة: ${e.message}`);
    return null;
  }
}

// ═══════════════════════════════════════════
// 4. اختيار Seeds من فئة محددة
// ═══════════════════════════════════════════

async function pickDiscoverySeeds(count, category) {
  const existing = await db.execute({
    sql: `SELECT keyword, category, source, run_count, last_run_at
          FROM keywords_pipeline
          WHERE enabled = 1 
            AND category = ?
            AND (last_run_at = 0 OR last_run_at IS NULL)
          ORDER BY priority ASC, run_count ASC, RANDOM()
          LIMIT ?`,
    args: [category, count * 3],
  });

  let pool = existing.rows;

  if (pool.length === 0) {
    console.log(`  ⚠️ لا كلمات جديدة في [${category}] — استخدام أي كلمات متاحة`);
    const all = await db.execute({
      sql: `SELECT keyword, category, source FROM keywords_pipeline
            WHERE enabled = 1 AND category = ?
            ORDER BY RANDOM() LIMIT ?`,
      args: [category, count],
    });
    return all.rows;
  }

  const rows = [...pool];
  for (let i = rows.length - 1; i > 0; i--) {
    const j = Math.floor(Math.random() * (i + 1));
    [rows[i], rows[j]] = [rows[j], rows[i]];
  }

  return rows.slice(0, count);
}

// ═══════════════════════════════════════════
// 5. Apify Discovery
// ═══════════════════════════════════════════

async function runApifyDiscovery(category) {
  console.log('\n🎭 Apify Discovery...');
  const seeds = await pickDiscoverySeeds(DISCOVERY_KEYWORDS, category);
  console.log(`  📋 ${seeds.length} كلمة من [${category}]\n`);

  let totalProducts = 0;
  let totalKeywords = 0;

  for (const seed of seeds) {
    if (providerState.apify.status === 'disabled') {
      console.log('  ⏭️ Apify معطل — توقف Discovery');
      break;
    }

    try {
      console.log(`  🔍 "${seed.keyword}"`);
      const items = await runApifyActor(seed.keyword, APIFY_MAX_ITEMS);

      if (!Array.isArray(items) || items.length === 0) {
        await markProcessed(seed.keyword, false);
        continue;
      }

      const result = await saveApifyProducts(items, seed.keyword, category);
      totalProducts += result.saved;
      totalKeywords += result.newKeywords;

      console.log(`     ✅ ${result.saved} منتج | ${result.newKeywords} كلمة`);
      await markProcessed(seed.keyword, result.saved > 0);
      await new Promise(r => setTimeout(r, 1000));
    } catch (e) {
      console.log(`     ❌ ${e.message.substring(0, 50)}`);
      
      if (e.message.includes('QUOTA')) {
        providerState.apify.status = 'disabled';
        providerState.apify.reason = 'quota_exhausted';
        break;
      }
      
      await markProcessed(seed.keyword, false);
    }
  }

  return { totalProducts, totalKeywords };
}

