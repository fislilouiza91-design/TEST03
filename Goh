/* ============================================
   Smart Shopper - Cloudflare Worker (Global Version)
   D1 (Monthly) + KV Cache (5 Days) + Dynamic Geo-Routing
   ============================================ */

const MAX_CONSECUTIVE_FAILURES = 10;
const CACHE_TTL = 432000; // 5 أيام

export default {
  async fetch(request, env, ctx) {
    const corsHeaders = {
      'Access-Control-Allow-Origin': '*',
      'Access-Control-Allow-Methods': 'GET, POST, OPTIONS',
      'Access-Control-Allow-Headers': 'Content-Type',
      'Access-Control-Max-Age': '86400'
    };

    if (request.method === 'OPTIONS') return new Response(null, { status: 204, headers: corsHeaders });

    try {
      const url = new URL(request.url);
      const productId = url.searchParams.get('productId');

      // 1. GET: جلب البيانات من (KV أو D1)
      if (request.method === 'GET' && url.pathname === '/api/competitors') {
        if (!productId) return json({ error: 'Missing productId' }, 400, corsHeaders);

        const cached = await env.COMPETITOR_CACHE.get(`comp:${productId}`, 'json');
        if (cached) return json({ source: 'kv', data: cached }, 200, corsHeaders);

        try {
          const { results } = await env.DB.prepare(`
            SELECT * FROM scraped_products_odd WHERE base_product_id = ? AND is_relevant = 1
            UNION ALL
            SELECT * FROM scraped_products_even WHERE base_product_id = ? AND is_relevant = 1
          `).bind(productId, productId).all();

          if (results && results.length > 0) {
            ctx.waitUntil(env.COMPETITOR_CACHE.put(`comp:${productId}`, JSON.stringify(results), { expirationTtl: CACHE_TTL }));
            return json({ source: 'd1', data: results }, 200, corsHeaders);
          }
        } catch (e) {
          return json({ error: e.message }, 500, corsHeaders);
        }
        return json({ status: 'not_found' }, 404, corsHeaders);
      }

      // 2. POST: حفظ البيانات
      if (request.method === 'POST' && url.pathname === '/api/competitors') {
        const body = await request.json();
        if (!body.base_product_id || !body.competitors || !Array.isArray(body.competitors)) {
          return json({ error: 'Invalid data' }, 400, corsHeaders);
        }

        const monthIndex = new Date().getUTCMonth(); 
        const tableName = monthIndex % 2 === 0 ? 'scraped_products_even' : 'scraped_products_odd';
        const now = Math.floor(Date.now() / 1000);

        const statements = body.competitors.map(c => {
          return env.DB.prepare(`
            INSERT INTO ${tableName} 
            (base_product_id, competitor_id, title, price, currency, seller_rating, product_url, coupon_code, coupon_discount, scraped_at)
            VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?)
            ON CONFLICT(base_product_id, competitor_id) DO UPDATE SET
            price = excluded.price, seller_rating = excluded.seller_rating,
            coupon_code = excluded.coupon_code, coupon_discount = excluded.coupon_discount,
            scraped_at = excluded.scraped_at
          `).bind(
            body.base_product_id, c.competitor_id, c.title, c.price, c.currency || 'USD', 
            c.seller_rating || 0, c.product_url, c.coupon_code || null, c.coupon_discount || null, now
          );
        });

        if (statements.length > 0) await env.DB.batch(statements);
        await env.COMPETITOR_CACHE.put(`comp:${body.base_product_id}`, JSON.stringify(body.competitors), { expirationTtl: CACHE_TTL });

        return json({ success: true, count: body.competitors.length }, 201, corsHeaders);
      }

      // 3. Fallback Scrape (مع دعم البلدان)
      if (request.method === 'GET' && url.pathname === '/api/fallback-scrape') {
        const requestUrl = url.searchParams.get('url');
        const country = url.searchParams.get('country') || 'US'; // افتراضي أمريكا
        const targetUrl = requestUrl ? requestUrl : `https://www.aliexpress.com/item/${productId}.html`;
        
        // المحاولة الأولى: بلد المستخدم. المحاولة الثانية (إذا فشلت): أمريكا لضمان بنية HTML
        let { html, provider } = await fetchWithFallback(targetUrl, country, env);
        
        if (!html && country !== 'US') {
          console.log(`[Fallback] Failed with ${country}, retrying with US...`);
          const fallbackResult = await fetchWithFallback(targetUrl, 'US', env);
          html = fallbackResult.html;
          provider = fallbackResult.provider + ' (US Fallback)';
        }

        if (!html) return json({ error: 'All providers failed or disabled' }, 502, corsHeaders);

        return json({ provider, html }, 200, corsHeaders);
      }

      // Health Check
      if (url.pathname === '/health') {
        const statuses = await getProviderStatuses(env);
        return json({ status: 'ok', providers: {
            scrapingant: formatStatus('scrapingant', statuses.scrapingant, !!env.SCRAPINGANT_KEY),
            scraperapi: formatStatus('scraperapi', statuses.scraperapi, !!env.SCRAPERAPI_KEY)
        }}, 200, corsHeaders);
      }

      return json({ error: 'Not found' }, 404, corsHeaders);
    } catch (e) {
      return json({ error: e.message }, 500, corsHeaders);
    }
  },

  async scheduled(event, env, ctx) {
    const now = new Date();
    ctx.waitUntil(healthCheckAllProviders(env));

    if (now.getUTCDate() === 1) {
      const monthIndex = now.getUTCMonth();
      const tableToClear = monthIndex % 2 === 0 ? 'scraped_products_odd' : 'scraped_products_even';
      
      try {
        await env.DB.batch([
          env.DB.prepare(`DROP TABLE IF EXISTS ${tableToClear}`),
          env.DB.prepare(`
            CREATE TABLE ${tableToClear} (
              id INTEGER PRIMARY KEY AUTOINCREMENT, base_product_id TEXT NOT NULL, competitor_id TEXT NOT NULL,
              title TEXT, price REAL, currency TEXT DEFAULT 'USD', seller_rating REAL, product_url TEXT,
              coupon_code TEXT, coupon_discount TEXT, is_relevant INTEGER DEFAULT 1, scraped_at INTEGER NOT NULL,
              UNIQUE(base_product_id, competitor_id)
            )
          `),
          env.DB.prepare(`CREATE INDEX idx_${tableToClear}_base ON ${tableToClear}(base_product_id, is_relevant)`)
        ]);
      } catch(e) {}
    }
  }
};

/* ============================================
   Circuit Breaker + Smart Retry (مع دعم البلدان)
   ============================================ */
async function fetchWithFallback(targetUrl, country, env) {
  const providers = [
    { name: 'scrapingant', key: env.SCRAPINGANT_KEY, fn: fetchFromScrapingAnt },
    { name: 'scraperapi', key: env.SCRAPERAPI_KEY, fn: fetchFromScraperAPI }
  ].filter(p => p.key);

  if (!providers.length) return { html: null, provider: null };

  for (const provider of providers) {
    const status = await getProviderStatus(provider.name, env);
    if (status.disabled) continue;

    for (let attempt = 1; attempt <= 3; attempt++) {
      try {
        const html = await provider.fn(targetUrl, provider.key, country);
        if (html && html.length > 5000) {
          return { html, provider: `${provider.name} (${country})` };
        }
      } catch (e) {
        const errType = classifyError(e);
        if (errType === 'QUOTA') {
          await disableProvider(provider.name, e.message, status, env);
          break;
        }
        if (errType === 'CONCURRENCY' || errType === 'RATE') {
          if (attempt < 3) { await sleep(2000 * attempt); continue; } else { break; }
        }
        break;
      }
    }
  }
  return { html: null, provider: null };
}

function classifyError(error) {
  const msg = String(error.message || '').toLowerCase();
  if (msg.includes('concurrency') || msg.includes('too many') || msg.includes('simultaneous') || msg.includes('busy')) return 'CONCURRENCY';
  if (msg.includes('429') || msg.includes('rate limit')) return 'RATE';
  if (msg.includes('credits exhausted') || msg.includes('quota exceeded') || msg.includes('out of credits') || msg.includes('no more credits') || msg.includes('insufficient credits') || msg.includes('credit balance') || msg.includes('subscription required') || msg.includes('payment required')) return 'QUOTA';
  return 'OTHER';
}

function sleep(ms) { return new Promise(r => setTimeout(r, ms)); }

/* ============================================
   Fetch Functions (Dynamic Proxy Country)
   ============================================ */
async function fetchFromScrapingAnt(targetUrl, apiKey, country) {
  const url = new URL('https://api.scrapingant.com/v2/general');
  url.searchParams.set('x-api-key', apiKey);
  url.searchParams.set('url', targetUrl);
  url.searchParams.set('browser', 'false');
  url.searchParams.set('proxy_country', country.toLowerCase()); // استخدام بلد المستخدم

  const res = await fetch(url.toString());
  if (!res.ok) {
    const errBody = await res.text();
    const lowerBody = errBody.toLowerCase();
    if (lowerBody.includes('concurrency')) throw new Error(`CONCURRENCY_LIMIT`);
    if (res.status === 429) throw new Error(`429 rate limit`);
    if (lowerBody.includes('credits exhausted') || lowerBody.includes('quota exceeded')) throw new Error(`402 credits exhausted`);
    throw new Error(`HTTP ${res.status}`);
  }
  return await res.text();
}

async function fetchFromScraperAPI(targetUrl, apiKey, country) {
  const url = new URL('https://api.scraperapi.com/');
  url.searchParams.set('api_key', apiKey);
  url.searchParams.set('url', targetUrl);
  url.searchParams.set('render', 'false');
  url.searchParams.set('country_code', country.toLowerCase()); // استخدام بلد المستخدم

  const res = await fetch(url.toString());
  if (!res.ok) {
    const errBody = await res.text();
    const lowerBody = errBody.toLowerCase();
    if (lowerBody.includes('concurrency')) throw new Error(`CONCURRENCY_LIMIT`);
    if (res.status === 429) throw new Error(`429 rate limit`);
    if (lowerBody.includes('credits exhausted') || lowerBody.includes('quota exceeded')) throw new Error(`402 credits exhausted`);
    throw new Error(`HTTP ${res.status}`);
  }
  return await res.text();
}

/* ============================================
   Provider Status Management
   ============================================ */
async function getProviderStatus(providerName, env) {
  try {
    const raw = await env.COMPETITOR_CACHE.get(`provider:${providerName}`);
    return raw ? JSON.parse(raw) : { disabled: false };
  } catch (e) { return { disabled: false }; }
}

async function getProviderStatuses(env) {
  return {
    scrapingant: await getProviderStatus('scrapingant', env),
    scraperapi: await getProviderStatus('scraperapi', env)
  };
}

async function disableProvider(providerName, reason, currentStatus, env) {
  const consecutiveFailures = (currentStatus.consecutiveFailures || 0) + 1;
  const status = {
    disabled: true, permanent: consecutiveFailures >= MAX_CONSECUTIVE_FAILURES,
    reason: reason, consecutiveFailures: consecutiveFailures,
    disabledAt: currentStatus.disabledAt || new Date().toISOString(),
    lastHealthCheck: new Date().toISOString()
  };
  await env.COMPETITOR_CACHE.put(`provider:${providerName}`, JSON.stringify(status), { expirationTtl: 86400 * 30 });
}

async function clearProviderStatus(providerName, env) {
  await env.COMPETITOR_CACHE.delete(`provider:${providerName}`);
}

function formatStatus(name, status, configured) {
  return { configured, disabled: status?.disabled || false, permanent: status?.permanent || false, consecutiveFailures: status?.consecutiveFailures || 0, reason: status?.reason || null };
}

async function healthCheckAllProviders(env) {
  const providers = [
    { name: 'scrapingant', key: env.SCRAPINGANT_KEY },
    { name: 'scraperapi', key: env.SCRAPERAPI_KEY }
  ].filter(p => p.key);

  for (const provider of providers) {
    const status = await getProviderStatus(provider.name, env);
    if (!status.disabled || status.permanent) continue;
    const recovered = await testProvider(provider.name, provider.key);
    if (recovered) await clearProviderStatus(provider.name, env);
  }
}

async function testProvider(providerName, apiKey) {
  try {
    const testUrl = 'https://httpbin.org/ip';
    const html = providerName === 'scrapingant' ? await fetchFromScrapingAnt(testUrl, apiKey, 'US') : await fetchFromScraperAPI(testUrl, apiKey, 'US');
    return html && html.length > 20;
  } catch (e) { return false; }
}

function json(data, status, corsHeaders) {
  return new Response(JSON.stringify(data), { status, headers: { ...corsHeaders, 'Content-Type': 'application/json' } });
}