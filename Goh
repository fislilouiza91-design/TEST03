/* ============================================
   Smart Shopper - Background Service Worker
   (Smart-Turso DB Edition)
   ============================================ */

// تأكد أن هذا هو الرابط الصحيح الذي نجح في المتصفح
const WORKER_URL = 'https://shopper.smailsuit11.workers.dev';

chrome.runtime.onMessage.addListener((msg, sender, sendResponse) => {
  if (!msg) return;

  if (msg.type === 'SMART_SEARCH') {
    handleSearch(msg, sender, sendResponse);
    return true; // ضروري للعمليات غير المتزامنة
  }

  if (msg.type === 'SMART_LOAD_MORE') {
    handleLoadMore(msg, sender, sendResponse);
    return true;
  }

  return true;
});

/* ============================================
   البحث الأولي (Page 1)
   ============================================ */
async function handleSearch(msg, sender, sendResponse) {
  const title = encodeURIComponent(msg.title || '');
  const url = `${WORKER_URL}/search-db?q=${title}&page=1`;

  console.log('[Smart Shopper BG] Fetching from DB:', url);

  try {
    const res = await fetch(url);
    
    if (!res.ok) {
      throw new Error(`HTTP Error: ${res.status}`);
    }
    
    const data = await res.json();
    console.log('[Smart Shopper BG] Received items:', data.items ? data.items.length : 0);
    
    sendResponse({
      ok: true,
      items: data.items || [],
      lastPage: 1,
      hasMore: data.hasMore || false,
      totalItems: data.items ? data.items.length : 0
    });
  } catch (e) {
    console.error('[Smart Shopper BG] Fetch Failed:', e.message);
    sendResponse({ ok: false, error: String(e) });
  }
}

/* ============================================
   المزيد (Load More)
   ============================================ */
async function handleLoadMore(msg, sender, sendResponse) {
  const title = encodeURIComponent(msg.title || '');
  const nextPage = Math.max(2, parseInt(msg.startPage) || 2);
  const existingIds = (msg.existingIds || []).join(',');
  
  const url = `${WORKER_URL}/search-db?q=${title}&page=${nextPage}&existingIds=${existingIds}`;

  console.log('[Smart Shopper BG] Loading more from DB, page:', nextPage);

  try {
    const res = await fetch(url);
    
    if (!res.ok) {
      throw new Error(`HTTP Error: ${res.status}`);
    }
    
    const data = await res.json();
    
    sendResponse({
      ok: true,
      items: data.items || [],
      lastPage: nextPage,
      hasMore: data.hasMore || false
    });
  } catch (e) {
    console.error('[Smart Shopper BG] Load More Failed:', e.message);
    sendResponse({ ok: false, error: String(e), hasMore: false });
  }
}