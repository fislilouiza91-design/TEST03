async function saveProductsBatch(products, keyword) {
  if (products.length === 0) return 0;

  const now = Date.now();
  const statements = products
    .filter(p => p.product_id && p.title && p.title.length > 5)
    .map(p => ({
      sql: `INSERT OR IGNORE INTO products 
            (product_id, title, title_tokens, current_price_usd,
             original_price_usd, rating, orders_count, image_url,
             image_hash, source_keyword, source_type,
             first_seen_at, last_updated_at)
            VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, 'enrichment', ?, ?)`,
      args: [p.product_id, p.title, extractTokens(p.title), p.price || 0,
        p.original_price || 0, p.rating || 0, 0,
        p.image_url || '', generateImageHash(p.image_url), keyword, now, now],
    }));

  if (statements.length === 0) return 0;

  let inserted = 0;
  try {
    const result = await db.batch(statements, 'write');
    for (const r of result) if (toNum(r.rowsAffected) > 0) inserted++;
  } catch (e) {
    console.error(`        ❌ ${e.message.substring(0, 60)}`);
  }

  return inserted;
}

