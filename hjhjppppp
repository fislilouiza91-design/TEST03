name: Test WebScraping.AI

on:
  workflow_dispatch:

jobs:
  test:
    runs-on: ubuntu-latest
    timeout-minutes: 10

    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Setup Node.js
        uses: actions/setup-node@v4
        with:
          node-version: '20'

      - name: Install node-fetch
        run: npm install node-fetch@3 --no-audit --no-fund

      - name: Run WebScraping.AI Test
        env:
          WEBSCRAPING_API_KEY: ${{ secrets.WEBSCRAPING_API_KEY }}
        run: node src/test-webscraping.js